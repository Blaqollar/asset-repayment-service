APP_NAME=asset-repayment-service
APP_ENV=development          # development | test | production
LOG_LEVEL=info               # debug | info | warn | error

# HTTP
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=90s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_MAX_BODY_BYTES=16384

# How long a single payment may occupy a worker. Providers retry a webhook
# after a couple of seconds, so holding one longer only creates duplicate work.
HTTP_REQUEST_TIMEOUT=5s

# Load-shedding ceiling: beyond this many concurrent payments the service
# returns 429 immediately instead of queueing work it cannot finish in time.
# Size it against DATABASE_MAX_OPEN_CONNS — raising it past what the pool can
# drain inside HTTP_REQUEST_TIMEOUT converts fast 429s into slow timeouts.
HTTP_MAX_INFLIGHT_PAYMENTS=1024

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/asset_repayment?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=25
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_AUTO_MIGRATE=true

# Redis backs both the lookaside cache and the payment queue. Without it the
# service is still correct: it loses the cache, and applies each payment in the
# request that delivered it rather than in a worker.
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=64
REDIS_TIMEOUT=50ms
REDIS_REF_TTL=30m
REDIS_RESULT_TTL=24h


# Queue — the OPTIONAL asynchronous ingest path, off by default.
#
# Off (the default): a payment is applied in the request that delivered it and
# the response carries the customer's updated position. This is the brief's
# answer and the right default at any rate the database can absorb.
#
# On: the webhook acknowledges the credit with 202 and a worker applies it,
# which lets a burst be absorbed at the rate the database sustains rather than
# the rate the provider sends. Requires REDIS_ADDRESS. The position then
# follows a beat later, which is the trade being made.
QUEUE_ENABLED=false
QUEUE_STREAM=payments:inbound
QUEUE_GROUP=payment-workers

# The real throttle on the system: how many payments are in flight against
# Postgres at once. Size it against DATABASE_MAX_OPEN_CONNS — more workers than
# connections just moves the queue into the connection pool.
QUEUE_WORKERS=16
QUEUE_BATCH_SIZE=64
QUEUE_BLOCK_TIMEOUT=2s
QUEUE_PROCESS_TIMEOUT=10s
QUEUE_TIMEOUT=2s

# A message unacknowledged for this long is assumed to belong to a dead worker
# and is handed to another. After MAX_ATTEMPTS it goes to the dead-letter
# stream (QUEUE_STREAM + ":dead") for manual reconciliation — never discarded.
QUEUE_CLAIM_MIN_IDLE=30s
QUEUE_CLAIM_INTERVAL=15s
QUEUE_MAX_ATTEMPTS=5
QUEUE_MAX_LEN=1000000

# Payments
# Required when APP_ENV=production: without it, anyone who can reach the
# endpoint can clear a customer's debt by posting a payload.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SIGNATURE_HEADER=X-Payment-Signature

# Provider timestamps arrive with no offset ("2025-11-07 14:54:16"); this is
# the zone they are read in before conversion to UTC.
PAYMENT_PROVIDER_TIMEZONE=Africa/Lagos

# Currency every amount is denominated in unless a request states its own.
# Nothing below the transport layer assumes a particular currency or a
# particular number of decimal places: NGN (2dp), JPY (0dp) and KWD (3dp) all
# work without a code change.
PAYMENT_CURRENCY=NGN

# Standard programme terms: 1,000,000 over 50 weeks.
PAYMENT_DEFAULT_PRINCIPAL=1000000
PAYMENT_DEFAULT_TERM_WEEKS=50

# Observability
METRICS_ENABLED=true
